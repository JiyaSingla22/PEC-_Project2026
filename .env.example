# ========================================================
# IncogniRead Environment Variables Template (.env.example)
# ========================================================

# Serverless Functions & Anonymous Discovery Graph Security
DISCOVERY_IP_SALT=incogniread_privacy_salt_2026_super_secure
JWT_SECRET=incogniread_jwt_production_secret_key_32_chars_min!
WEBHOOK_SECRET=incogniread_webhook_secret_key_2026_secure
ALLOWED_ORIGINS=*

# Optional Backend & MongoDB Connection (for local Express server)
MONGODB_URI=mongodb+srv://admin:admin@cluster0.cw3tn.mongodb.net/articles?retryWrites=true&w=majority&appName=Cluster0
PORT=3000
IP_HASH_SALT=incogniread_privacy_salt_2026

# Frontend Client Public Variables (Vite)
VITE_APP_NAME=IncogniRead
VITE_APP_VERSION=1.0.0
